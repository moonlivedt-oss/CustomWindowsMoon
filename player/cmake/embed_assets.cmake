# Превращает файлы assets в builtin_assets.h: массив { путь, содержимое }.
# Содержимое пишется как сырой строковый литерал, разбитый на куски по 8 КБ
# (у некоторых компиляторов есть предел длины одного литерала).
set(out "// Сгенерировано cmake/embed_assets.cmake, не править руками\n#pragma once\n\n")
string(APPEND out "namespace pm::builtin {\n\nstruct Asset {\n    const char* path;\n    const char* const* parts;\n    int partCount;\n};\n\n")
string(REPLACE "|" ";" FILES "${FILES}")
set(index 0)
set(table "")
foreach(f ${FILES})
    file(READ ${SRC}/${f} content)
    string(LENGTH "${content}" len)
    set(parts "")
    set(count 0)
    set(pos 0)
    while(pos LESS len)
        string(SUBSTRING "${content}" ${pos} 8000 chunk)
        string(APPEND parts "    R\"PMRAW(${chunk})PMRAW\",\n")
        math(EXPR pos "${pos} + 8000")
        math(EXPR count "${count} + 1")
    endwhile()
    string(APPEND out "inline const char* const kParts${index}[] = {\n${parts}};\n")
    string(APPEND table "    {\"${f}\", kParts${index}, ${count}},\n")
    math(EXPR index "${index} + 1")
endforeach()
string(APPEND out "\ninline const Asset kAssets[] = {\n${table}};\ninline constexpr int kAssetCount = ${index};\n\n}  // namespace pm::builtin\n")
file(WRITE ${OUT} "${out}")
