# Карта символов для разбора падений (Н10): пока exe ещё с символами - nm в
# %APPDATA%\MoonDesk\integrity\maps\<имя>-<метка сборки>.map, потом (STRIP=ON) символы убираются из самого exe.
# Метка сборки - TimeDateStamp из заголовка PE: её же пишет core/crash в строку падения, по ней --crash-decode
# находит карту той самой сборки. Хранятся 10 последних карт каждого exe.
# Вызов: cmake -DEXE=<exe> -DNM=<nm> -DSTRIP_TOOL=<strip> -DSTRIP=ON|OFF -P symbols.cmake
file(READ "${EXE}" lfanew HEX OFFSET 60 LIMIT 4)
string(SUBSTRING "${lfanew}" 0 2 b0)
string(SUBSTRING "${lfanew}" 2 2 b1)
string(SUBSTRING "${lfanew}" 4 2 b2)
math(EXPR pe "0x${b2}${b1}${b0}" OUTPUT_FORMAT DECIMAL)
math(EXPR at "${pe} + 8")
file(READ "${EXE}" stamp HEX OFFSET ${at} LIMIT 4)
string(SUBSTRING "${stamp}" 0 2 s0)
string(SUBSTRING "${stamp}" 2 2 s1)
string(SUBSTRING "${stamp}" 4 2 s2)
string(SUBSTRING "${stamp}" 6 2 s3)
string(TOUPPER "${s3}${s2}${s1}${s0}" stamp)
get_filename_component(name "${EXE}" NAME_WE)
set(dir "$ENV{APPDATA}/MoonDesk/integrity/maps")
file(MAKE_DIRECTORY "${dir}")
execute_process(COMMAND "${NM}" -C --defined-only --numeric-sort "${EXE}" OUTPUT_FILE "${dir}/${name}-${stamp}.map"
                RESULT_VARIABLE rc)
if(NOT rc EQUAL 0)
  message(WARNING "nm: ${rc}")
endif()
file(GLOB maps "${dir}/${name}-*.map")
list(SORT maps)
list(LENGTH maps n)
while(n GREATER 10)
  list(POP_FRONT maps old)
  file(REMOVE "${old}")
  math(EXPR n "${n} - 1")
endwhile()
if(STRIP)
  execute_process(COMMAND "${STRIP_TOOL}" --strip-all "${EXE}" RESULT_VARIABLE rc)
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "strip: ${rc}")
  endif()
endif()
